# Copia para .env.local e preenche.

# ─── Login (Clerk) ───────────────────────────────────────────────
# dashboard.clerk.com → o teu projecto → API Keys
# Os fornecedores (Google, Microsoft, Apple, Facebook, GitHub, email…) activam-se no painel do Clerk.
# Sem estas chaves, em desenvolvimento o Clerk corre em "modo sem chaves" (projecto temporário).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Base de dados e ficheiros (Supabase) ────────────────────────
# Sem DATABASE_URL, os dados ficam no ficheiro local .data/db.json (desenvolvimento sem internet).
# Project Settings → Database → Connection string → "Transaction pooler" (porta 6543).
# As tabelas são criadas sozinhas na primeira ligação.
# ex.: postgresql://postgres.xxxx:PALAVRA-PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Project Settings → API: Project URL e a chave "service_role" (secreta: nunca no browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Notificações push (lembretes com a app fechada) ─────────────
# Gera com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contacto para os serviços de push (mailto: ou https:)
VAPID_SUBJECT=mailto:suporte@exemplo.com
# protege /api/cron/reminders se usares um agendador externo (ex.: Vercel Cron)
CRON_SECRET=

# ─── Opcionais ───────────────────────────────────────────────────
# pasta dos dados locais (sem DATABASE_URL); útil para testes
# NEEMA_DATA_DIR=.data
# ligações simultâneas à base de dados por instância (Vercel: 1–3)
# DATABASE_POOL_MAX=5

# ─── Painel de administração (/marcos/faz) ───────────────────────
# Credenciais de acesso ao painel (só no servidor; nunca no browser)
ADMIN_PANEL_EMAIL=
ADMIN_PANEL_PASSWORD=
# segredo para assinar o cookie de sessão do painel; gera com: openssl rand -hex 32
ADMIN_SESSION_SECRET=
